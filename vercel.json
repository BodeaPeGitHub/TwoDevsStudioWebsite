{
  "rewrites": [
    {
      "source": "/api/ibric-push",
      "destination": "/api/ibric"
    },
    {
      "source": "/ibric",
      "destination": "/api/ibric"
    },
    {
      "source": "/ibric/:path*",
      "destination": "/api/ibric"
    },
    {
      "source": "/api/ibric/:path*",
      "destination": "/api/ibric?route=:path*"
    },
    {
      "source": "/api/cuc/:path*",
      "destination": "/api/cuc?route=:path*"
    },
    {
      "source": "/api/letscoffee/:path*",
      "destination": "/api/letscoffee?route=:path*"
    },
    {
      "source": "/api/orso/:path*",
      "destination": "/api/orso?route=:path*"
    },
    {
      "source": "/api/guau/:path*",
      "destination": "/api/guau?route=:path*"
    },
    {
      "source": "/api/brewkai/:path*",
      "destination": "/api/brewkai?route=:path*"
    },
    {
      "source": "/api/acadeea-push",
      "destination": "/api/acadeea?route=worker"
    },
    {
      "source": "/api/acadeea/:path*",
      "destination": "/api/acadeea?route=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ibric.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/cuc.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/cuc-push.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/letscoffee.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/letscoffee-push.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/orso.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/orso-push.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/guau.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/guau-push.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/brewkai.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/brewkai-push.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    },
    "api/acadeea.js": {
      "maxDuration": 90,
      "regions": [
        "arn1"
      ]
    }
  },
  "headers": [
    {
      "source": "/ibric/:path*",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/ibric/push-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/ibric"
        }
      ]
    },
    {
      "source": "/cuc/:path*",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
