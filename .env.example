VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# IBRIC: server-only variables. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IBRIC_SESSION_SECRET=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
WALLET_ASSET_ORIGIN=
GOOGLE_WALLET_DEMO_MODE=true

# Web Push: generate a VAPID pair once and keep it stable across deployments.
# The public key is served by /api/ibric/config; both keys stay out of VITE_ vars.
IBRIC_PUSH_PUBLIC_KEY=
IBRIC_PUSH_PRIVATE_KEY=
# Must match the ibric_web_push_worker_secret entry in Supabase Vault.
IBRIC_PUSH_WORKER_SECRET=

# CUC uses the same Supabase project and Google issuer, with separate staff and push secrets.
CUC_SESSION_SECRET=
CUC_PUSH_PUBLIC_KEY=
CUC_PUSH_PRIVATE_KEY=
# Must match cuc_web_push_worker_secret in Supabase Vault.
CUC_PUSH_WORKER_SECRET=
# Optional overrides. Defaults keep CUC separate from the existing IBRIC class.
CUC_GOOGLE_WALLET_CLASS_ID=
CUC_WALLET_ASSET_ORIGIN=https://www.twodevsstudio.com/cuc/wallet/v5

# New programs: independent secrets, separate from CUC and IBRIC.
# Configure once with scripts/configure-new-coffee.mjs; keep VAPID keys stable.
LETSCOFFEE_SESSION_SECRET=
LETSCOFFEE_PUSH_PUBLIC_KEY=
LETSCOFFEE_PUSH_PRIVATE_KEY=
LETSCOFFEE_PUSH_WORKER_SECRET=
ORSO_SESSION_SECRET=
ORSO_PUSH_PUBLIC_KEY=
ORSO_PUSH_PRIVATE_KEY=
ORSO_PUSH_WORKER_SECRET=
GUAU_SESSION_SECRET=
GUAU_PUSH_PUBLIC_KEY=
GUAU_PUSH_PRIVATE_KEY=
GUAU_PUSH_WORKER_SECRET=

# Brewkai uses its own staff-session and notification secrets.
BREWKAI_SESSION_SECRET=
BREWKAI_PUSH_PUBLIC_KEY=
BREWKAI_PUSH_PRIVATE_KEY=
# Matches brewkai_web_push_worker_secret in Supabase Vault.
BREWKAI_PUSH_WORKER_SECRET=

# Acadeea has independent staff-session and notification secrets.
ACADEEA_SESSION_SECRET=
ACADEEA_PUSH_PUBLIC_KEY=
ACADEEA_PUSH_PRIVATE_KEY=
# Matches acadeea_web_push_worker_secret in Supabase Vault.
ACADEEA_PUSH_WORKER_SECRET=
